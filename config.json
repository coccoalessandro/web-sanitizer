{
  "html": {
    "allowed_tags": [
      "p", "a", "div", "span", "h1", "h2", "b", "i"
    ],
    "allowed_attributes": {
      "a": [ "href", "title" ],
      "img": [ "src", "alt" ]
    },
    "rewrite_active_content": true,
    "block_javascript_uris": true,
    "block_data_uris": true,
    "block_meta_refresh": true,
    "trusted_iframe_origins": []
  },
  "urls": {
    "blocked_domains": [],
    "tracker_domains": [],
    "check_idn_homographs": true,
    "suspicious_link_action": { "ReplaceWithWarning": "[REMOVED SUSPICIOUS LINK]" }
  },
  "resources": {
    "max_fetch_depth": 3,
    "max_requests_per_job": 50,
    "max_resource_size_bytes": 2097152,
    "max_decompressed_size_bytes": 10485760,
    "timeout_ms": 5000,
    "block_internal_ips": true,
    "enforce_mime_sniffing": true
  }
}
